---
/**
 * HeroText — a full-bleed display statement for MDX prose.
 *
 * Lifts a single sentence out of the body column and sets it as a Fraunces display line across the whole window. Use it for the one line a piece pivots on — a thesis, a call to action — not for headings (those are what h2/h3 are for).
 *
 * ## Usage in MDX
 *   import HeroText from '../components/HeroText.astro';
 *
 *   <HeroText>Accordionists deserve better sheets.</HeroText>
 *
 * ## Geometry
 * It takes the `full` track of the .prose grid (global.css), so it needs no margin tricks of its own and stays inside the page whether the prose column is the full window or sits beside a table of contents.
 *
 * It is a tint rather than a reversed panel: a saturated band would be the loudest thing on a site whose whole argument is made quietly, and it would fight the ink-on-paper snippets on either side of it.
 */
---

<div class="hero-text">
    <div class="hero-text__inner">
        <slot />
    </div>
</div>

<style>
    .hero-text {
        margin-block: clamp(3rem, 7vw, 5rem);
        padding: clamp(2.25rem, 5vw, 3.5rem) var(--prose-padding-x);
        background: var(--paper-tint);
        border-block: 1px solid var(--rule);
        text-align: center;
    }

    .hero-text__inner {
        max-width: min(90vw, 18em);
        margin-inline: auto;
        font-family: var(--font-display), Georgia, serif;
        font-weight: 600;
        font-size: clamp(1.7rem, 1rem + 2.6vw, 2.75rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--ink);
        text-wrap: balance;
    }

    /* MDX wraps slot text in <p>; drop its margins so the band stays centred. */
    .hero-text__inner :global(p) {
        margin: 0;
    }
</style>
