---
/**
 * Steps — a numbered sequence you're expected to carry out, as opposed to an ordinary ordered list you're expected to read.
 *
 * Wrap a markdown ordered list; each item gets a numbered marker and the line down the side ties the sequence together, so a code block inside a step still reads as part of that step.
 *
 *   <Steps>
 *
 *   1. Save this file next to your score:
 *
 *       <SaveFile … />
 *
 *   2. Include it from your score:
 *
 *   </Steps>
 */
---

<div class="steps">
    <slot />
</div>

<style>
    .steps {
        margin-block: 1.5rem;
    }

    .steps :global(ol) {
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: step;
    }

    .steps :global(ol > li) {
        counter-increment: step;
        position: relative;
        margin: 0;
        padding-inline-start: 2.75rem;
        padding-block-end: 1.25rem;
        /* The line runs between the markers, and the last item's border is hidden behind its own marker's negative space rather than being special-cased. */
        border-inline-start: 1px solid var(--rule);
        margin-inline-start: 0.875rem;
    }

    .steps :global(ol > li:last-child) {
        border-inline-start-color: transparent;
        padding-block-end: 0;
    }

    .steps :global(ol > li)::before {
        content: counter(step);
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        transform: translateX(-50%);
        display: grid;
        place-items: center;
        width: 1.85rem;
        height: 1.85rem;
        border-radius: 50%;
        background: var(--spark);
        color: var(--paper);
        font-family: var(--font-display), Georgia, serif;
        font-weight: 700;
        font-size: 0.9rem;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    /* With room in the left margin, the numbers and their line hang there, so the steps' content stays flush with the prose above and below. Below this width the margin is too narrow, and the numbers stay inline. */
    @media (min-width: 46rem) {
        .steps :global(ol > li) {
            padding-inline-start: 0;
            margin-inline-start: 0;
            border-inline-start: 0;
        }

        /* Centre the disc on the first line's box (line-height 1.65 of --step-0), and sink the digit a little so its baseline meets the text's rather than its middle meeting the text's middle. */
        .steps :global(ol > li)::before {
            inset-inline-start: -1.5rem;
            inset-block-start: calc((var(--step-0) * 1.65 - 1.85rem) / 2);
            font-size: 1rem;
            padding-block-start: 0.12rem;
        }

        .steps :global(ol > li)::after {
            content: "";
            position: absolute;
            inset-block: 1.85rem 0;
            inset-inline-start: -1.5rem;
            width: 1px;
            background: var(--rule);
        }

        .steps :global(ol > li:last-child)::after {
            display: none;
        }
    }

    /* The first line of a step should sit level with its number, not start a paragraph's worth below it. */
    .steps :global(ol > li > :first-child) {
        margin-block-start: 0;
    }

    .steps :global(ol > li > :last-child) {
        margin-block-end: 0;
    }
</style>
