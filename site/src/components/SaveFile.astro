---
/**
 * SaveFile — a download link with enough presence to be the thing you came for.
 *
 * Replaces starlight-save-file-component, whose only real dependency on Starlight was its icon set and colour tokens.
 *
 *   <SaveFile title="Download stradella-clef.ly" href="https://…/stradella-clef.ly" />
 *
 * `download` on a cross-origin href is ignored by browsers, so a link to raw.githubusercontent.com navigates rather than saving. That's fine for a .ly file, which GitHub serves as text/plain: the browser shows it and the reader saves it from there.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'title'> {
    title: string;
    description?: string;
    fileName?: string;
}

const { title, description, fileName, ...attributes } = Astro.props;
---

<div class="save-file">
    <span class="save-file__text">
        <a {...attributes} download={fileName ?? ''}>{title}</a>
        {description && <span class="save-file__description">{description}</span>}
    </span>
    <svg class="save-file__icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12" />
        <path d="m7 10 5 5 5-5" />
        <path d="M4 20h16" />
    </svg>
</div>

<style>
    .save-file {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: center;
        position: relative;
        margin-block: 1.25rem;
        padding: 1rem 1.25rem;
        background: var(--paper-tint);
        border: 1px solid var(--rule);
        border-radius: 4px;
        transition: border-color 120ms ease;
    }

    .save-file__text {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    a {
        font-weight: 600;
        text-decoration: none;
        line-height: 1.3;
    }

    /* Stretch the link over the whole card, so the padding is clickable too. */
    a::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
    }

    .save-file__description {
        color: var(--ink-soft);
        font-size: 0.9375rem;
        line-height: 1.4;
    }

    .save-file__icon {
        color: var(--ink-soft);
        transition: color 120ms ease, transform 120ms ease;
    }

    .save-file:hover {
        border-color: var(--accent);
    }

    .save-file:hover .save-file__icon {
        color: var(--accent);
        transform: translateY(2px);
    }

    @media (prefers-reduced-motion: reduce) {
        .save-file__icon {
            transition: color 120ms ease;
        }

        .save-file:hover .save-file__icon {
            transform: none;
        }
    }
</style>
