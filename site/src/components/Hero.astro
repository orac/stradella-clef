---
/**
 * Hero — the opening of the landing page: the name, the promise, and the two ways in.
 *
 * The expansiveness comes from the space around the words rather than from a coloured band, so the hero reads as the first page of a book rather than as a product banner. Actions take paths relative to the site root; href() adds the `base` prefix.
 */
import { href } from '../lib/href';

interface Props {
    tagline: string;
    actions: { text: string; path: string }[];
}

const { tagline, actions } = Astro.props;
---

<header class="hero">
    <h1>Stradella&nbsp;clef</h1>
    <p class="hero__tagline">{tagline}</p>
    <p class="hero__actions">
        {actions.map(({ text, path }, i) => (
            <a href={href(path)} class={i === 0 ? 'hero__action hero__action--first' : 'hero__action'}>
                {text}<span aria-hidden="true"> →</span>
            </a>
        ))}
    </p>
</header>

<style>
    /* No rule along the bottom: the first h2 brings its own, and two hairlines a few centimetres apart would read as a mistake. */
    .hero {
        padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 7vw, 5rem);
    }

    h1 {
        font-size: clamp(2.75rem, 1.2rem + 6.5vw, 5.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .hero__tagline {
        max-width: 24ch;
        margin-block: 1.25rem 0;
        font-family: var(--font-display), Georgia, serif;
        font-size: clamp(1.3rem, 0.9rem + 1.4vw, 1.8rem);
        font-weight: 400;
        font-style: italic;
        line-height: 1.3;
        color: var(--ink-soft);
        text-wrap: balance;
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        margin-block: clamp(2rem, 5vw, 3rem) 0;
        font-size: 1.0625rem;
    }

    .hero__action {
        text-decoration: none;
        color: var(--ink-soft);
    }

    .hero__action--first {
        color: var(--accent);
        font-weight: 600;
    }

    .hero__action:hover {
        color: var(--accent-lift);
        text-decoration: underline;
        text-underline-offset: 0.3em;
    }
</style>
