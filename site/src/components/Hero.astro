---
/**
 * Hero — the opening of the landing page: the name, the promise, and the two ways in.
 *
 * The words now sit over a photograph of a Stradella bass mechanism, rather than the empty paper the rest of the site holds to — this is the one place on the site allowed a proper flourish. The photo is a `full` track item of the .prose grid (global.css), stacked in the same grid row as the header content so it reaches the true viewport edge and stretches to the header's height, the same mechanism HeroText uses for its own full-bleed band. A vignette — darkest in the middle, where the words sit, easing off towards all four edges — plus a text-shadow on the title and tagline, and solid backgrounds under both actions, keep everything legible without flattening the photo into a plain backdrop. Actions are handed straight to Cta.
 */
import { Image } from 'astro:assets';
import Cta from './Cta.astro';

interface Props {
    tagline: string;
    actions: { text: string; path: string }[];
    image: ImageMetadata;
}

const { tagline, actions, image } = Astro.props;
---

<div class="hero__bg">
    <Image src={image} alt="" role="presentation" widths={[640, 960, 1440, 1920, 2560]} sizes="100vw" />
</div>
<header class="hero">
    <h1>Stradella&nbsp;clef</h1>
    <p class="hero__tagline">{tagline}</p>
    <div class="hero__actions">
        <Cta actions={actions} />
    </div>
</header>

<style>
    /* No rule along the bottom: the first h2 brings its own, and two hairlines a few centimetres apart would read as a mistake. */
    .hero {
        position: relative;
        padding-block: clamp(4rem, 14vw, 9rem) clamp(3.5rem, 9vw, 6rem);
    }

    /* Shares the header's grid row (set alongside .hero in global.css) so it stretches to the same height, and paints behind it by simple document order — no z-index needed. */
    .hero__bg {
        position: relative;
        overflow: clip;
    }

    .hero__bg :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* A vignette rather than a directional wash: darkest where the words actually sit, easing off towards all four edges so the mechanism stays readable as a photo at the margins. */
    .hero__bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 62% 75% at 50% 50%, color-mix(in srgb,black 58%, transparent) 0%, color-mix(in srgb, black 30%, transparent) 55%, transparent 90%);
    }

    h1 {
        position: relative;
        font-size: clamp(2.75rem, 1.2rem + 6.5vw, 5.5rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.035em;
        margin: 0;
        color: var(--paper);
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6), 0 1px 3px rgba(0, 0, 0, 0.55);
    }

    .hero__tagline {
        position: relative;
        max-width: 24ch;
        margin-block: 1.25rem 0;
        font-family: var(--font-display), Georgia, serif;
        font-size: clamp(1.3rem, 0.9rem + 1.4vw, 1.8rem);
        font-weight: 400;
        font-style: italic;
        line-height: 1.3;
        color: var(--paper);
        text-wrap: balance;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.6), 0 1px 2px rgba(0, 0, 0, 0.55);
    }

    .hero__actions {
        position: relative;
        margin-block: clamp(2rem, 5vw, 3rem) 0;
    }

    /* The plain-text action elsewhere just tints on hover; here it needs to be a button in its own right, since there's no scrim left to lift it off the photo. Dark-grey fill with a brass outline, echoing the filled action's colour without competing with it. */
    .hero__actions :global(.cta__action:not(.cta__action--first)) {
        padding: 0.65rem 1.25rem;
        background: color-mix(in srgb, var(--ink) 62%, transparent);
        border: 1.5px solid var(--spark);
        border-radius: 2px;
        color: var(--paper);
        font-weight: 700;
        transition: background 120ms ease, border-color 120ms ease, transform 120ms ease;
    }

    .hero__actions :global(.cta__action:not(.cta__action--first):hover) {
        background: color-mix(in srgb, var(--ink) 78%, transparent);
        border-color: var(--spark-lift);
        transform: translateY(-1px);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__actions :global(.cta__action:not(.cta__action--first)) {
            transition: none;
        }
    }
</style>
